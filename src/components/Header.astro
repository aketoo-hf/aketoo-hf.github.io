---
import type { Dict, Locale } from '../i18n/types';
import { getNavLinks, isCurrentPage, switchLocalePath } from '../i18n';
import Icon from './ui/Icon.astro';

export interface Props {
  t: Dict;
  locale: Locale;
}

const { t, locale } = Astro.props;
const pathname = Astro.url.pathname;
const links = getNavLinks(t, locale);
const zhHref = switchLocalePath(pathname, 'zh');
const enHref = switchLocalePath(pathname, 'en');
---

<header
  class="sticky top-0 z-50 w-full border-b border-line backdrop-blur-[12px]"
  style="background:rgba(12,14,16,0.85);"
>
  <div class="shell flex h-[68px] items-center justify-between gap-6">
    <!-- brand: a copper powder grain, the latin mark, then the local name -->
    <a
      href={locale === 'zh' ? '/' : '/en/'}
      class="flex shrink-0 items-center gap-3"
      aria-label={t.nav.brandHomeLabel}
    >
      <svg
        width="18"
        height="18"
        viewBox="0 0 20 20"
        class="shrink-0 text-accent"
        aria-hidden="true"
        focusable="false"
      >
        <rect x="4" y="4" width="12" height="12" transform="rotate(45 10 10)" fill="currentColor" />
      </svg>
      <span class="text-[15px] font-semibold tracking-[0.08em] text-text">{t.nav.brandLatin}</span>
      {
        t.nav.brandLocal && (
          <>
            <span class="h-4 w-px bg-line-strong" aria-hidden="true"></span>
            <span class="text-[15px] text-text-dim">{t.nav.brandLocal}</span>
          </>
        )
      }
    </a>

    <!-- desktop navigation, single row -->
    <nav class="hidden lg:block" aria-label={t.nav.menuLabel}>
      <ul class="flex items-center gap-7">
        {
          links.map((link) => {
            const current = isCurrentPage(pathname, link.key, locale);
            return (
              <li>
                <a
                  href={link.href}
                  aria-current={current ? 'page' : undefined}
                  class={`text-sm transition-colors duration-150 ${
                    current
                      ? 'text-text underline decoration-accent decoration-2 underline-offset-[6px]'
                      : 'text-text-dim hover:text-text'
                  }`}
                >
                  {link.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="flex items-center gap-4">
      <!-- language switch -->
      <div class="flex items-center gap-2 text-sm" aria-label={t.nav.langLabel}>
        <a
          href={zhHref}
          hreflang="zh-CN"
          lang="zh-CN"
          aria-current={locale === 'zh' ? 'true' : undefined}
          class={locale === 'zh' ? 'text-accent-strong' : 'text-text-dim hover:text-text'}
        >
          {t.nav.langZh}
        </a>
        <span class="text-text-faint" aria-hidden="true">/</span>
        <a
          href={enHref}
          hreflang="en"
          lang="en"
          aria-current={locale === 'en' ? 'true' : undefined}
          class={locale === 'en' ? 'text-accent-strong' : 'text-text-dim hover:text-text'}
        >
          {t.nav.langEn}
        </a>
      </div>

      <!-- mobile menu trigger -->
      <button
        type="button"
        id="nav-toggle"
        class="flex h-10 w-10 items-center justify-center rounded-control border border-line text-text lg:hidden"
        aria-label={t.nav.menuOpen}
        aria-expanded="false"
        aria-controls="nav-panel"
        data-label-open={t.nav.menuOpen}
        data-label-close={t.nav.menuClose}
      >
        <Icon name="menu" size={20} class="nav-icon-menu" />
        <Icon name="close" size={20} class="nav-icon-close hidden" />
      </button>
    </div>
  </div>

  <!-- mobile panel -->
  <div
    id="nav-panel"
    hidden
    class="border-t border-line bg-bg lg:hidden"
  >
    <nav aria-label={t.nav.menuLabel} class="shell py-4">
      <ul class="flex flex-col">
        {
          links.map((link) => {
            const current = isCurrentPage(pathname, link.key, locale);
            return (
              <li class="border-b border-line last:border-b-0">
                <a
                  href={link.href}
                  aria-current={current ? 'page' : undefined}
                  class={`block py-4 text-base ${current ? 'text-accent-strong' : 'text-text'}`}
                >
                  {link.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('nav-panel');

  if (toggle && panel) {
    const iconMenu = toggle.querySelector('.nav-icon-menu');
    const iconClose = toggle.querySelector('.nav-icon-close');
    const labelOpen = toggle.dataset.labelOpen ?? '';
    const labelClose = toggle.dataset.labelClose ?? '';

    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? labelClose : labelOpen);
      iconMenu?.classList.toggle('hidden', open);
      iconClose?.classList.toggle('hidden', !open);
    };

    toggle.addEventListener('click', () => {
      setOpen(panel.hidden);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !panel.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });

    // the panel only exists below 1024px, close it when the desktop row takes over
    const desktop = window.matchMedia('(min-width: 1024px)');
    const onChange = (event: MediaQueryListEvent | MediaQueryList) => {
      if (event.matches) setOpen(false);
    };
    desktop.addEventListener('change', onChange);
  }
</script>
