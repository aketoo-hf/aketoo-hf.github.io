---
// shared heading block: optional eyebrow, required title, optional lead paragraph
// eyebrow use is rationed by spec section 3 (max 1 per 3 sections, max 3 per page)
export interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
  /** heading level, h2 by default */
  level?: 1 | 2 | 3;
  id?: string;
  class?: string;
  titleClass?: string;
  leadClass?: string;
  /** visually hide the title while keeping it in the accessibility tree */
  srOnlyTitle?: boolean;
}

const {
  title,
  eyebrow,
  lead,
  level = 2,
  id,
  class: className = '',
  titleClass = '',
  leadClass = '',
  srOnlyTitle = false,
} = Astro.props;

const Tag = `h${level}` as 'h1' | 'h2' | 'h3';

const sizeByLevel: Record<1 | 2 | 3, string> = {
  1: 'text-4xl md:text-5xl lg:text-6xl',
  2: 'text-2xl md:text-3xl lg:text-4xl',
  3: 'text-lg md:text-xl',
};

const srOnly = 'absolute w-px h-px p-0 -m-px overflow-hidden whitespace-nowrap border-0';
const titleClasses = srOnlyTitle
  ? srOnly
  : [sizeByLevel[level], 'font-semibold text-text', titleClass].filter(Boolean).join(' ');
---

<div class={className}>
  {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
  <Tag id={id} class={titleClasses}>{title}</Tag>
  {
    lead && (
      <p class={['mt-5 max-w-[65ch] text-base leading-relaxed text-text-dim', leadClass].filter(Boolean).join(' ')}>
        {lead}
      </p>
    )
  }
  <slot />
</div>
