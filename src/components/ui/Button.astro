---
// primary = copper fill with near black ink, secondary = hairline outline
// radius is locked to the 8px control token, no pills anywhere
export interface Props {
  variant?: 'primary' | 'secondary';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  size?: 'md' | 'sm';
  class?: string;
  id?: string;
  disabled?: boolean;
  'aria-label'?: string;
  'data-testid'?: string;
}

const {
  variant = 'primary',
  href,
  type = 'button',
  size = 'md',
  class: className = '',
  id,
  disabled = false,
  ...rest
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-control font-medium leading-none transition-colors duration-150 active:translate-y-px disabled:opacity-50 disabled:pointer-events-none';

const sizes: Record<'md' | 'sm', string> = {
  md: 'px-6 py-3.5 text-base',
  sm: 'px-4 py-2.5 text-sm',
};

const variants: Record<'primary' | 'secondary', string> = {
  primary: 'bg-accent text-accent-ink hover:bg-accent-strong',
  secondary:
    'border border-line-strong text-text hover:border-accent hover:text-accent-strong bg-transparent',
};

const classes = [base, sizes[size], variants[variant], className].filter(Boolean).join(' ');
---

{
  href ? (
    <a href={href} class={classes} id={id} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} id={id} disabled={disabled} {...rest}>
      <slot />
    </button>
  )
}
