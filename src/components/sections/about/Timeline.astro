---
import type { Dict, Locale } from '../../../i18n/types';
import Reveal from '../../ui/Reveal.astro';
import SectionHeading from '../../ui/SectionHeading.astro';

// about S3: vertical timeline, mono years parked to the left of a hairline axis.
// the final row is the AKETOO handover, so its node and year carry the copper accent.
export interface Props {
  t: Dict;
  locale: Locale;
}

const { t, locale } = Astro.props;
const s = t.about.timeline;
const lastIndex = s.items.length - 1;
---

<section
  class="shell border-t border-line py-16 md:py-24"
  data-section="about/Timeline"
  data-locale={locale}
>
  <Reveal>
    <SectionHeading title={s.heading} />

    <ol class="timeline">
      {
        s.items.map((item, i) => (
          <li class:list={['tl-item', i === lastIndex && 'is-latest']}>
            <span class="tl-node" aria-hidden="true" />
            <span class="tl-year num">{item.year}</span>
            <p class="tl-event">{item.event}</p>
          </li>
        ))
      }
    </ol>
  </Reveal>
</section>

<style>
  .timeline {
    margin-top: 3rem;
    list-style: none;
    padding: 0;
  }

  .tl-item {
    position: relative;
    border-left: 1px solid var(--color-line);
    padding-left: 1.75rem;
    padding-bottom: 2.25rem;
  }

  .tl-item:last-child {
    padding-bottom: 0;
  }

  /* powder crystal node: a small square turned 45deg, same idea as the brand mark */
  .tl-node {
    position: absolute;
    left: 0;
    top: 0.55rem;
    width: 7px;
    height: 7px;
    background-color: var(--color-bg);
    border: 1px solid var(--color-line-strong);
    transform: translateX(-50%) rotate(45deg);
  }

  .tl-item.is-latest .tl-node {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .tl-year {
    display: block;
    font-size: 0.875rem;
    line-height: 1.6;
    letter-spacing: 0.04em;
    /* text-dim, not text-faint: the year is the row label, so it has to clear AA */
    color: var(--color-text-dim);
  }

  .tl-item.is-latest .tl-year {
    color: var(--color-accent);
  }

  .tl-event {
    margin-top: 0.25rem;
    color: var(--color-text-dim);
    max-width: 52ch;
  }

  @media (min-width: 768px) {
    .timeline {
      padding-left: 7rem;
    }

    .tl-item {
      padding-left: 2.5rem;
      padding-bottom: 2.75rem;
    }

    .tl-node {
      top: 0.6rem;
    }

    .tl-year {
      position: absolute;
      left: -7rem;
      top: 0;
      width: 5.5rem;
      text-align: right;
      font-size: 1rem;
      line-height: 1.7;
    }

    .tl-event {
      margin-top: 0;
    }
  }
</style>
