---
import type { Dict, Locale } from '../../../i18n/types';
import Reveal from '../../ui/Reveal.astro';
import SectionHeading from '../../ui/SectionHeading.astro';

// about S4: 2x2 data grid for the Dongguan base. hairlines only, never cards.
// the single per page source footnote sits directly under this grid (spec 6.2).
export interface Props {
  t: Dict;
  locale: Locale;
}

const { t, locale } = Astro.props;
const s = t.about.facility;
---

<section
  class="border-y border-line bg-bg-raised"
  data-section="about/Facility"
  data-locale={locale}
>
  <div class="shell py-16 md:py-24">
    <Reveal>
      <SectionHeading title={s.heading} />

      <dl class="facility-grid">
        {
          s.items.map((item) => (
            <div class="facility-cell">
              <dt class="facility-label">{item.label}</dt>
              <dd class="facility-value num">
                {item.value}
                {item.unit ? <span class="facility-unit">{item.unit}</span> : null}
              </dd>
            </div>
          ))
        }
      </dl>

      <p class="facility-note">{s.footnote}</p>
    </Reveal>
  </div>
</section>

<style>
  .facility-grid {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .facility-cell {
    border-top: 1px solid var(--color-line);
    padding-block: 1.5rem;
  }

  /* close the bottom of the second row so the block reads as a data table */
  .facility-cell:nth-child(n + 3) {
    border-bottom: 1px solid var(--color-line);
  }

  .facility-cell:nth-child(odd) {
    padding-right: 1rem;
  }

  .facility-cell:nth-child(even) {
    padding-left: 1rem;
    border-left: 1px solid var(--color-line);
  }

  .facility-label {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-text-dim);
  }

  .facility-value {
    margin-top: 0.625rem;
    font-size: 1.5rem;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .facility-unit {
    margin-left: 0.35rem;
    font-size: 0.9rem;
    color: var(--color-text-dim);
  }

  .facility-note {
    margin-top: 1.75rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-text-faint);
  }

  @media (min-width: 640px) {
    .facility-value {
      font-size: 1.875rem;
    }
  }

  @media (min-width: 768px) {
    .facility-grid {
      margin-top: 3rem;
    }

    .facility-cell {
      padding-block: 2.25rem;
    }

    .facility-cell:nth-child(odd) {
      padding-right: 2.5rem;
    }

    .facility-cell:nth-child(even) {
      padding-left: 2.5rem;
    }

    .facility-value {
      font-size: 2.25rem;
    }

    .facility-unit {
      font-size: 1rem;
    }

    .facility-note {
      margin-top: 2rem;
    }
  }
</style>
