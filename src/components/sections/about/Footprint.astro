---
import type { Dict, Locale } from '../../../i18n/types';
import Reveal from '../../ui/Reveal.astro';
import SectionHeading from '../../ui/SectionHeading.astro';

// about S5: market footprint, three text columns under hairline rules, no cards.
export interface Props {
  t: Dict;
  locale: Locale;
}

const { t, locale } = Astro.props;
const s = t.about.footprint;
---

<section class="shell py-16 md:py-24" data-section="about/Footprint" data-locale={locale}>
  <Reveal>
    <SectionHeading title={s.heading} />

    <div class="mt-10 grid gap-x-10 gap-y-10 md:mt-14 md:grid-cols-3 md:gap-x-12 lg:gap-x-16">
      {
        s.items.map((item) => (
          <div class="border-t border-line pt-6">
            <h3 class="text-lg font-semibold text-text">{item.title}</h3>
            <p class="mt-3 max-w-[38ch] text-base leading-relaxed text-text-dim">{item.body}</p>
          </div>
        ))
      }
    </div>
  </Reveal>
</section>
