---
import { Image } from 'astro:assets';
import type { Dict, Locale } from '../../../i18n/types';
import Icon from '../../ui/Icon.astro';
import Reveal from '../../ui/Reveal.astro';
import powderGreen from '../../../assets/images/powder-green.jpg';

// s4 flagship grade: 50/50 split banded off by hairlines, a 4:3 crop of the
// powder shot on the left and the mono parameter table on the right.
export interface Props {
  t: Dict;
  locale: Locale;
}

const { t, locale } = Astro.props;
const s = t.home.flagship;
---

<section
  class="border-y border-line"
  data-section="home/Flagship"
  data-locale={locale}
  aria-labelledby="home-flagship-heading"
>
  <div class="shell py-16 md:py-20 lg:py-24">
    <Reveal>
      <div class="grid items-center gap-10 md:gap-12 lg:grid-cols-2 lg:gap-16">
        <div class="flagship-media overflow-hidden rounded-panel border border-line">
          <Image
            src={powderGreen}
            alt={s.imageAlt}
            widths={[480, 720, 960]}
            sizes="(min-width: 1024px) 46vw, 100vw"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover"
          />
        </div>

        <div>
          <h2
            id="home-flagship-heading"
            class="text-2xl font-semibold text-text md:text-3xl lg:text-4xl"
          >
            {s.heading}
          </h2>

          <dl class="specs mt-8">
            {
              s.specs.map((spec) => (
                <div class="spec-row">
                  <dt class="spec-label">{spec.label}</dt>
                  <dd class="spec-value num">
                    {spec.value}
                    {spec.unit && <span class="spec-unit"> {spec.unit}</span>}
                  </dd>
                </div>
              ))
            }
          </dl>

          <p class="mt-8 max-w-[60ch] text-base leading-relaxed text-text-dim">{s.summary}</p>

          <a href={s.linkHref} class="text-link group mt-7 inline-flex items-center gap-2">
            <span>{s.linkLabel}</span>
            <Icon
              name="arrow-right"
              size={18}
              class="shrink-0 transition-transform duration-200 group-hover:translate-x-1"
            />
          </a>
        </div>
      </div>
    </Reveal>
  </div>
</section>

<style>
  .flagship-media {
    aspect-ratio: 4 / 3;
  }

  .spec-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 0.875rem;
    border-top: 1px solid var(--color-line);
  }

  .spec-row:last-child {
    border-bottom: 1px solid var(--color-line);
  }

  .spec-label {
    font-size: 0.875rem;
    color: var(--color-text-dim);
  }

  .spec-value {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text);
    text-align: right;
    white-space: nowrap;
  }

  .spec-unit {
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--color-accent);
  }

  .text-link {
    color: var(--color-accent);
    font-size: 0.9375rem;
    transition: color 0.15s ease;
  }

  .text-link > span {
    border-bottom: 1px solid transparent;
    padding-bottom: 2px;
    transition: border-color 0.15s ease;
  }

  .text-link:hover {
    color: var(--color-accent-strong);
  }

  .text-link:hover > span {
    border-bottom-color: currentColor;
  }

  @media (min-width: 768px) {
    .spec-value {
      font-size: 1.25rem;
    }
  }
</style>
