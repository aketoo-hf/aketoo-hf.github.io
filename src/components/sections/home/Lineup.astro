---
import { Image } from 'astro:assets';
import type { Dict, Locale } from '../../../i18n/types';
import Icon from '../../ui/Icon.astro';
import Reveal from '../../ui/Reveal.astro';
import busbarEpoxy from '../../../assets/images/busbar-epoxy-green.jpg';
import busbarPvc from '../../../assets/images/busbar-pvc-blue.jpg';

// the two product lines shown as equals: real coated-busbar photography above
// a short performance list, so the page states what the company actually makes.
export interface Props {
  t: Dict;
  locale: Locale;
}

const { t, locale } = Astro.props;
const s = t.home.lineup;
const photos = [busbarEpoxy, busbarPvc];
---

<section
  class="border-y border-line"
  data-section="home/Lineup"
  data-locale={locale}
  aria-labelledby="home-lineup-heading"
>
  <div class="shell py-16 md:py-20 lg:py-24">
    <Reveal>
      <h2 id="home-lineup-heading" class="text-2xl font-semibold text-text md:text-3xl">
        {s.heading}
      </h2>

      <div class="mt-10 grid gap-10 md:mt-12 md:grid-cols-2 md:gap-12">
        {
          s.items.map((item, i) => (
            <article>
              <div class="media overflow-hidden rounded-panel border border-line">
                <Image
                  src={photos[i]}
                  alt={item.imageAlt}
                  widths={[480, 600]}
                  sizes="(min-width: 768px) 46vw, 100vw"
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover"
                />
              </div>

              <h3 class="mt-6 text-lg font-semibold text-text md:text-xl">{item.title}</h3>
              <p class="mt-3 max-w-[46ch] text-sm leading-relaxed text-text-dim">{item.body}</p>

              <ul class="mt-5 flex flex-wrap gap-x-5 gap-y-2">
                {item.highlights.map((h) => (
                  <li class="flex items-center gap-2 text-sm text-text-dim">
                    <span class="marker" aria-hidden="true" />
                    {h}
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>

      <a href={s.linkHref} class="text-link group mt-12 inline-flex items-center gap-2">
        <span>{s.linkLabel}</span>
        <Icon
          name="arrow-right"
          size={18}
          class="shrink-0 transition-transform duration-200 group-hover:translate-x-1"
        />
      </a>
    </Reveal>
  </div>
</section>

<style>
  .media {
    aspect-ratio: 4 / 3;
  }

  .marker {
    flex-shrink: 0;
    width: 5px;
    height: 5px;
    background-color: var(--color-accent);
    transform: rotate(45deg);
  }

  .text-link {
    color: var(--color-accent);
    font-size: 0.9375rem;
    transition: color 0.15s ease;
  }

  .text-link > span {
    border-bottom: 1px solid transparent;
    padding-bottom: 2px;
    transition: border-color 0.15s ease;
  }

  .text-link:hover {
    color: var(--color-accent-strong);
  }

  .text-link:hover > span {
    border-bottom-color: currentColor;
  }
</style>
