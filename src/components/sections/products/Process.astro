---
import Icon from '../../ui/Icon.astro';
import Reveal from '../../ui/Reveal.astro';
import type { Dict, Locale } from '../../../i18n/types';

// spec 6.3 S4: three verb titled columns joined by arrow icons.
// no numbered step labels anywhere, the arrows carry the sequence.
export interface Props {
  t: Dict;
  locale: Locale;
}

const { t, locale } = Astro.props;
const s = t.products.process;
---

<section
  class="shell py-16 md:py-24"
  aria-labelledby="products-process-heading"
  data-section="products/Process"
  data-locale={locale}
>
  <Reveal>
    <h2 id="products-process-heading" class="text-2xl font-semibold text-text md:text-3xl">
      {s.heading}
    </h2>

    <div
      class="mt-10 grid gap-y-8 md:mt-14 md:grid-cols-[1fr_auto_1fr_auto_1fr] md:items-start md:gap-x-6 lg:gap-x-10"
    >
      {
        s.steps.map((step, index) => (
          <>
            {index > 0 && (
              <div class="flex justify-center md:pt-7">
                <Icon name="arrow-right" size={22} class="rotate-90 text-accent md:rotate-0" />
              </div>
            )}
            <div class="border-t border-line pt-6">
              <h3 class="text-lg font-semibold text-text">{step.title}</h3>
              <p class="mt-3 max-w-[42ch] text-[15px] leading-relaxed text-text-dim">{step.body}</p>
            </div>
          </>
        ))
      }
    </div>
  </Reveal>
</section>
