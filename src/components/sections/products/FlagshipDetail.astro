---
import { Image } from 'astro:assets';
import Icon from '../../ui/Icon.astro';
import Reveal from '../../ui/Reveal.astro';
import powderGreen from '../../../assets/images/powder-green.jpg';
import { localizePath } from '../../../i18n';
import type { Dict, Locale } from '../../../i18n/types';
import { productsCopy } from './copy';

// spec 6.3 S2: split with the powder image on the right, content on the left,
// key parameters as four raised tiles in a 2x2 grid with mono display values.
export interface Props {
  t: Dict;
  locale: Locale;
}

const { t, locale } = Astro.props;
const s = t.products.flagship;
const copy = productsCopy[locale];

// the degree sign hugs its digits, word shaped units keep a space
const specs = s.specs.map((spec) => ({ ...spec, tight: spec.unit === '°' }));

// deep link into the matching application section, locale aware
const applicationsHref = localizePath('/applications/#ai-computing', locale);
---

<section
  class="shell py-16 md:py-24"
  aria-labelledby="products-flagship-heading"
  data-section="products/FlagshipDetail"
  data-locale={locale}
>
  <Reveal class="grid items-center gap-10 lg:grid-cols-12 lg:gap-14">
    <div class="lg:col-span-7">
      <p class="flex items-center gap-2.5 text-sm text-text-dim">
        <span class="h-[7px] w-[7px] shrink-0 rotate-45 bg-accent" aria-hidden="true"></span>
        {s.tag}
      </p>

      <h2
        id="products-flagship-heading"
        class="mt-4 text-2xl font-semibold text-text md:text-3xl lg:text-4xl"
      >
        {s.heading}
      </h2>

      <p class="mt-5 max-w-[60ch] text-base leading-relaxed text-text-dim">{s.body}</p>

      <div class="mt-9 grid grid-cols-2 gap-3 md:mt-10 md:gap-4">
        {
          specs.map((spec) => (
            <div class="top-highlight rounded-panel border border-line bg-bg-raised p-4 md:p-6">
              <p class="num text-xl leading-none text-text md:text-3xl">
                {spec.value}
                {spec.unit && (
                  <span
                    class:list={[
                      'whitespace-nowrap text-[13px] text-text-dim md:text-base',
                      !spec.tight && 'ml-1.5',
                    ]}
                  >
                    {spec.unit}
                  </span>
                )}
              </p>
              <p class="mt-3 text-[13px] leading-snug text-text-dim">{spec.label}</p>
            </div>
          ))
        }
      </div>

      <a
        href={applicationsHref}
        class="group mt-8 inline-flex items-center gap-2 text-sm font-medium text-accent transition-colors hover:text-accent-strong md:mt-10"
      >
        {copy.applicationsLink}
        <Icon
          name="arrow-right"
          size={18}
          class="transition-transform duration-150 group-hover:translate-x-0.5"
        />
      </a>
    </div>

    <div class="lg:col-span-5">
      <div class="overflow-hidden rounded-panel border border-line">
        <Image
          src={powderGreen}
          alt={s.imageAlt}
          widths={[480, 720, 1024]}
          sizes="(min-width: 1024px) 38vw, (min-width: 768px) 70vw, 100vw"
          class="aspect-[4/3] w-full object-cover lg:aspect-[4/5]"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  </Reveal>
</section>
