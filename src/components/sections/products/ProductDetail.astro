---
import { Image } from 'astro:assets';
import type { Dict, Locale, ProductEntry } from '../../../i18n/types';
import Reveal from '../../ui/Reveal.astro';
import busbarEpoxy from '../../../assets/images/busbar-epoxy-green.jpg';
import busbarPvc from '../../../assets/images/busbar-pvc-blue.jpg';

// one product line: photo on one side, performance and application lists on
// the other. the two lines mirror each other so neither reads as secondary.
export interface Props {
  t: Dict;
  locale: Locale;
  product: ProductEntry;
  /** the second line flips the split so the page does not zigzag identically */
  flipped?: boolean;
  raised?: boolean;
}

const { t, locale, product, flipped = false, raised = false } = Astro.props;
const labels = t.products;
const photo = product.id === 'pvc-plastisol' ? busbarPvc : busbarEpoxy;
const headingId = `product-${product.id}-heading`;
const eager = !flipped;
---

<section
  id={product.id}
  class:list={['border-t border-line', raised && 'bg-bg-raised']}
  data-section={`products/${product.id}`}
  data-locale={locale}
  aria-labelledby={headingId}
>
  <div class="shell py-16 md:py-20 lg:py-24">
    <Reveal>
      <div
        class:list={[
          'grid gap-10 md:gap-12 lg:grid-cols-12 lg:gap-16',
          flipped && 'lg:[&>*:first-child]:order-2',
        ]}
      >
        <div class="lg:col-span-5">
          <div class="media overflow-hidden rounded-panel border border-line">
            <Image
              src={photo}
              alt={product.imageAlt}
              widths={[480, 600]}
              sizes="(min-width: 1024px) 40vw, 100vw"
              loading={eager ? 'eager' : 'lazy'}
              decoding="async"
              class="h-full w-full object-cover"
            />
          </div>
        </div>

        <div class="lg:col-span-7">
          <p class="tag flex items-center gap-2 text-sm text-text-dim">
            <span class="grain" aria-hidden="true"></span>
            {product.tag}
          </p>

          <h2 id={headingId} class="mt-4 text-2xl font-semibold text-text md:text-3xl">
            {product.heading}
          </h2>

          <p class="mt-5 max-w-[56ch] text-base leading-relaxed text-text-dim">{product.body}</p>

          {
            product.specs.length > 0 && (
              <dl class="mt-8 grid gap-4 sm:grid-cols-2">
                {product.specs.map((spec) => (
                  <div class="spec rounded-panel border border-line bg-bg p-5 top-highlight">
                    <dd class="spec-value num">
                      {spec.value}
                      {spec.unit && <span class="spec-unit"> {spec.unit}</span>}
                    </dd>
                    <dt class="spec-label">{spec.label}</dt>
                  </div>
                ))}
              </dl>
            )
          }

          <div class="mt-10 grid gap-x-12 gap-y-8 sm:grid-cols-2">
            <div>
              <h3 class="list-heading">{labels.performanceLabel}</h3>
              <ul class="mt-4 flex flex-col gap-2">
                {
                  product.performance.map((item) => (
                    <li class="flex items-start gap-3 text-sm leading-relaxed text-text-dim">
                      <span class="marker" aria-hidden="true" />
                      {item}
                    </li>
                  ))
                }
              </ul>
            </div>

            <div>
              <h3 class="list-heading">{labels.applicationsLabel}</h3>
              <ul class="mt-4 flex flex-col gap-2">
                {
                  product.applications.map((item) => (
                    <li class="flex items-start gap-3 text-sm leading-relaxed text-text-dim">
                      <span class="marker" aria-hidden="true" />
                      {item}
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>

          {
            product.certifications && (
              <p class="mt-8 border-t border-line pt-6 text-sm text-text-dim">
                {product.certifications}
              </p>
            )
          }

          <p class="mt-6 text-sm text-text-dim">
            <span class="text-text-faint">{labels.serviceLabel}</span>
            <span class="ml-3">{product.service}</span>
          </p>
        </div>
      </div>
    </Reveal>
  </div>
</section>

<style>
  .media {
    aspect-ratio: 4 / 3;
  }

  /* the brand grain, echoed as a small rotated copper square */
  .grain {
    display: inline-block;
    width: 7px;
    height: 7px;
    background-color: var(--color-accent);
    transform: rotate(45deg);
  }

  /* measured parameters lead with the figure, label underneath, so the numbers
     scan first for an engineer skimming the page */
  .spec-value {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.1;
    color: var(--color-text);
  }

  .spec-unit {
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--color-accent);
  }

  .spec-label {
    margin-top: 0.625rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-text-dim);
  }

  .list-heading {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text);
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-line);
  }

  .marker {
    flex-shrink: 0;
    width: 5px;
    height: 5px;
    margin-top: 0.55rem;
    background-color: var(--color-accent);
    transform: rotate(45deg);
  }

  @media (min-width: 1024px) {
    .media {
      aspect-ratio: 4 / 5;
    }
  }
</style>
