---
import Reveal from '../../ui/Reveal.astro';
import type { Dict, Locale } from '../../../i18n/types';

// spec 6.4 S5: right aligned copy against an oversized mono year on the left.
// the year repeats a fact already in the body copy, so it is hidden from AT.
export interface Props {
  t: Dict;
  locale: Locale;
}

const { t, locale } = Astro.props;
const s = t.applications.automotive;
const headingId = `${s.id}-heading`;
---

<section
  id={s.id}
  class="shell py-16 md:py-24"
  aria-labelledby={headingId}
  data-section="applications/Automotive"
  data-locale={locale}
>
  <Reveal class="grid items-center gap-8 lg:grid-cols-12 lg:gap-12">
    {
      s.anchorYear && (
        <p
          class="num text-[clamp(3.5rem,11vw,7rem)] leading-none text-accent lg:col-span-5"
          aria-hidden="true"
        >
          {s.anchorYear}
        </p>
      )
    }

    <div class="lg:col-span-7 lg:text-right">
      <span class="block h-px w-10 bg-accent lg:ml-auto" aria-hidden="true"></span>

      <h2 id={headingId} class="mt-6 text-2xl font-semibold text-text md:text-3xl lg:text-4xl">
        {s.heading}
      </h2>

      <p class="mt-6 max-w-[60ch] text-base leading-relaxed text-text-dim lg:ml-auto">{s.body}</p>
    </div>
  </Reveal>
</section>
