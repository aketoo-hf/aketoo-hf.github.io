---
import Reveal from '../../ui/Reveal.astro';
import type { Dict, Locale } from '../../../i18n/types';

// spec 6.4 S4: plain text stack, no image. framed by hairlines and indented on
// large screens so the quiet beat still reads as a section of its own.
export interface Props {
  t: Dict;
  locale: Locale;
}

const { t, locale } = Astro.props;
const s = t.applications.passive;
const headingId = `${s.id}-heading`;
---

<section
  id={s.id}
  class="shell"
  aria-labelledby={headingId}
  data-section="applications/Passive"
  data-locale={locale}
>
  <Reveal class="border-y border-line py-14 md:py-20 lg:pl-[8%]">
    <span class="block h-px w-10 bg-accent" aria-hidden="true"></span>

    <h2 id={headingId} class="mt-6 text-2xl font-semibold text-text md:text-3xl lg:text-4xl">
      {s.heading}
    </h2>

    <p class="mt-6 max-w-[52ch] text-lg leading-relaxed text-text-dim md:text-xl">{s.body}</p>
  </Reveal>
</section>
