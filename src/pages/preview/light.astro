---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/sections/home/Hero.astro';
import Stats from '../../components/sections/home/Stats.astro';
import Domains from '../../components/sections/home/Domains.astro';
import Flagship from '../../components/sections/home/Flagship.astro';
import Endorsement from '../../components/sections/home/Endorsement.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getDict } from '../../i18n';
import type { Locale } from '../../i18n/types';

// light-theme comparison build: identical content and components to the home
// page, only the token set differs. temporary, delete once the theme is settled.
const locale: Locale = 'zh';
const t = getDict(locale);
---

<BaseLayout t={t} locale={locale} page="home" theme="light">
  <Hero t={t} locale={locale} />
  <Stats t={t} locale={locale} />
  <Domains t={t} locale={locale} />
  <Flagship t={t} locale={locale} />
  <Endorsement t={t} locale={locale} />

  <CtaBand t={t} locale={locale} />
</BaseLayout>
