---
import '../styles/global.css';
import type { Dict, Locale, PageKey } from '../i18n/types';
import { absoluteUrl, localizePath, pagePaths } from '../i18n';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ChatWidget from '../components/ChatWidget.astro';

export interface Props {
  t: Dict;
  locale: Locale;
  page: PageKey;
  /** organization json-ld is emitted on the home page only */
  organizationJsonLd?: boolean;
}

const { t, locale, page, organizationJsonLd = false } = Astro.props;

const seo = t.seo[page];
const neutralPath = pagePaths[page];

// preview deploys live on github.io and must stay out of search results,
// so the real site keeps sole ownership of the aketoo.com content
const isPreviewHost = Astro.site?.hostname.endsWith('github.io') ?? false;

const canonical = absoluteUrl(localizePath(neutralPath, locale), Astro.site);
const zhUrl = absoluteUrl(localizePath(neutralPath, 'zh'), Astro.site);
const enUrl = absoluteUrl(localizePath(neutralPath, 'en'), Astro.site);
const ogImage = absoluteUrl(t.seo.ogImage, Astro.site);

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'AKETOO (Dongguan) Electronic Insulation Materials Co., Ltd.',
  alternateName: '阿克图（东莞）电子绝缘材料有限公司',
  url: 'https://www.aketoo.com/',
  logo: ogImage,
  image: ogImage,
  email: 'sales@aketoo.com',
  telephone: '+86 139 4711 3888',
  address: {
    '@type': 'PostalAddress',
    streetAddress:
      'Guancheng Zone, Eastern Industrial Park, Jiangnan Avenue, Boxia Village, Qishi Town',
    addressLocality: 'Dongguan',
    addressRegion: 'Guangdong',
    addressCountry: 'CN',
  },
};
---

<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={canonical} />

    {isPreviewHost && <meta name="robots" content="noindex, nofollow" />}

    <link rel="alternate" hreflang="zh-CN" href={zhUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={zhUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.seo.siteName} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.seo.ogImageAlt} />
    <meta property="og:locale" content={locale === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#0C0E10" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {
      organizationJsonLd && (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(organization)} />
      )
    }

    <!-- arm css animations only when scripting is available -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body class="min-h-screen bg-bg text-text antialiased">
    <a
      href="#main"
      class="sr-only-focusable absolute left-4 top-4 z-[80] rounded-control bg-accent px-4 py-2 text-sm text-accent-ink"
    >
      {t.nav.skipToContent}
    </a>

    <Header t={t} locale={locale} />

    <main id="main">
      <slot />
    </main>

    <Footer t={t} locale={locale} />
    <ChatWidget t={t} locale={locale} />
  </body>
</html>
